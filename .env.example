# ==============================================================
# CONFIGURACIÓN DEL SERVIDOR - TORNEO DEL TALENTO MULTIJUGADOR
# ==============================================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP en el que escuchará el servidor Express
PORT=3000

# URL PÚBLICA del sistema (CRÍTICO: El código QR generará los enlaces con este dominio)
# En producción (Hostinger VPS / EasyPanel): https://torneo.tudominio.com
# En desarrollo local: http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Conexión a PostgreSQL
# Formato: postgresql://[usuario]:[password]@[host]:[puerto]/[nombre_bd]
# Ejemplo EasyPanel interno: postgresql://postgres:mypassword@postgres:5432/torneo_talento
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/torneo_talento

# Clave secreta administrativa para autenticación del organizador
ADMIN_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO

# Tolerancia de latencia de red (milisegundos de gracia tras expirar el temporizador)
# Recomendado: 500 - 800 ms para redes Wi-Fi o datos móviles
LATENCY_GRACE_PERIOD_MS=800

# Control de orígenes CORS (usar * para aceptar conexiones de cualquier origen o especificar dominios separados por coma)
CORS_ORIGIN=*

